# ---------- Core ----------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=mongodb://127.0.0.1:27017/vaultreel

# ---------- Auth ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Seed account (used only by `npm run seed`)
SEED_EMAIL=owner@example.com
SEED_PASSWORD=change-me-now

# ---------- Object storage (S3 compatible) ----------
# s3 | r2 | minio | b2 | wasabi  -> all use the S3 API
STORAGE_PROVIDER=r2
STORAGE_BUCKET=vaultreel
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Required for R2 / MinIO / B2 / Wasabi. Leave empty for AWS S3.
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# true for MinIO and other path-style servers
STORAGE_FORCE_PATH_STYLE=false

# ---------- Quota (bytes) ----------
TOTAL_STORAGE_BYTES=45097156608
MAX_VIDEO_BYTES=16106127360
UPLOAD_PART_SIZE_BYTES=67108864
